# ==============================================================================
# DrugEx Project Root .gitignore
# ==============================================================================

# --- Local Research & Private Environments ---
!_david/tests/**
!_david/output/.gitkeep
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/consult-literature/
!.agents/skills/drug-design-science/
_david/validation/
_david/code/tmp/
_david/data/
_david/thesis_tracking/
_david/einfra_proxy/
_david/*.html
# --- Dynamic Run Outputs & Generated Artifacts ---
*/output/*
*/outputs/*
_david/tests/molecular_dynamics/*/*
_david/output/*
_david/tests/molecular_dynamics/*
# The conformer suite's published deliverables *are* the thesis artifact: track
# them so a figure and the table digests it was rendered from can never drift
# apart, and so they are visible in git-aware file explorers. Everything else
# under output/ stays untracked (raw runs, caches, model checkpoints).
!/_david/output/conformer/
!/_david/output/conformer/**
# The output index is documentation, not a run: it maps every category and says
# what is disposable, so it belongs with the code.
!/_david/output/README.md

# --- Heavy Model Weights & Binary Checkpoints ---
*.pkg
*.tgz
*.gzip
*.tar.gz
*.vocab
*.tsv.vocab
**/*.cv.tsv
**/*.ind.tsv
**/*_smiles.tsv

# --- Downloaded Datasets & Symlinks ---
/data/
/data
/tutorial/data
/tutorial/advanced/data
/tutorial/CLI/examples
download.json
download.log
**/download.json
**/download.log
**/.Papyrus/

# --- Tutorial Generated Outputs ---
/tutorial/advanced/datasets/
/tutorial/advanced/models/
/tutorial/advanced/rocs/demo_out/
/tutorial/advanced/rocs/rl_runs_demo/
/tutorial/advanced/rocs/threshold_analysis_results/
/tutorial/advanced/rocs/rocs_rl_ccr/
/tutorial/advanced/rocs/*.log
/tutorial/advanced/rocs/*.png
/tutorial/advanced/rocs/*.csv
/tutorial/advanced/rocs/*.txt

# --- Temporary Files & Test Scratch ---
/_test_*
_test_*/
test_notebook_runner.py
test_cell*.py
/test_*.py
/tmp/
/tmp*
# --- Scratch dirs, credentials and private tracking data: never committed ---
# `_david/code/tmp/` is the transient MetaCentrum/dichtator staging area: run
# scripts there carry live API keys and job metadata that belong in manifests,
# not in git. `previous_runs/` is documented as safe to delete at any time.
/_david/code/tmp/
# Agent proxy wrappers hard-code an e-infra key; private session/timing logs quote
# credentials verbatim. Both stay on disk and out of the repository.
/_david/agent_documentasion/einfra_proxy/
/_david/agent_documentasion/thesis_tracking/
/testing/clitest/data/*.txt
/testing/clitest/data/*.vocab
/testing/clitest/data/backup*
/testing/clitest/data/dataset.json
/testing/clitest/generators/
/testing/clitest/new_molecules/
/docs/_build
/qspr/

# --- Python, Cache, and Virtual Environments ---
.vscode/
.idea/
__pycache__/
*.py[cod]
*$py.class
*.so
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.log

.env
.venv/
uv.lock
env/
venv/
ENV/

build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
*.egg
MANIFEST

.ipynb_checkpoints
.mypy_cache/
.dmypy.json
dmypy.json

